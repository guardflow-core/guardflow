[project]
name = "seve-framework-research"
version = "0.1.0"
description = "SEVE (Symbeon Ethical Vision Engine) - Research-only isolated copy for academic use"
readme = "README.md"
requires-python = ">=3.10"
license = { file = "LICENSE" }
authors = [ { name = "GuardFlow / Symbeon", email = "research@symbeon.ai" } ]
keywords = ["SEVE", "SYMBEON", "ethical AI", "ESG", "vision", "checkout", "research"]
classifiers = [
  "License :: Other/Proprietary License",
  "Programming Language :: Python :: 3",
  "Intended Audience :: Science/Research",
  "Topic :: Scientific/Engineering :: Artificial Intelligence",
]

[project.urls]
Homepage = "https://github.com/guardflow"
Documentation = "docs/OVERVIEW.md"

[tool.setuptools]
package-dir = {"" = "src"}

[tool.pytest.ini_options]
minversion = "7.0"
addopts = "-q"

[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"


